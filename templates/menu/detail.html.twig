{% extends 'base.html.twig' %}

{% block title %}{{ menu.title }} - Vite & Gourmand{% endblock %}

{% block body %}
<main>
    <section class="menu-detail">
        <a href="{{ path('app_menu') }}">← Retour aux menus</a>

        <h1>{{ menu.title }}</h1>

        <p>{{ menu.description }}</p>

        <h2>Informations</h2>

        <p><strong>Thème :</strong> {{ menu.theme }}</p>
        <p><strong>Régime :</strong> {{ menu.regime }}</p>
        <p><strong>Nombre minimum :</strong> {{ menu.minPeople }} personnes</p>
        <p><strong>Prix :</strong> {{ menu.price }} €</p>
        <p><strong>Stock disponible :</strong> {{ menu.stock }} commandes</p>

        <h2>Composition du menu</h2>

        {% for dish in menu.dishes %}
            <article class="dish">
                <h3>{{ dish.type }} — {{ dish.name }}</h3>
                <p>{{ dish.description }}</p>
            </article>
        {% else %}
            <p>Aucun plat renseigné pour ce menu.</p>
        {% endfor %}

        <h2>Conditions du menu</h2>

        <p>{{ menu.conditions }}</p>

        <a href="#">Commander ce menu</a>
    </section>
</main>
{% endblock %}