{% extends 'base.html.twig' %}

{% block title %}Nos menus - Vite & Gourmand{% endblock %}

{% block body %}
<main>
    <section class="menus-section">
        <h1>Nos menus</h1>

        <p>Découvrez les menus proposés par Vite & Gourmand pour vos événements.</p>

        <div class="filters">
            <h2>Rechercher un menu</h2>

            <label for="theme">Thème</label>
            <select id="theme">
                <option value="">Tous</option>
                <option value="Classique">Classique</option>
                <option value="Noël">Noël</option>
                <option value="Pâques">Pâques</option>
                <option value="Événement">Événement</option>
            </select>

            <label for="regime">Régime</label>
            <select id="regime">
                <option value="">Tous</option>
                <option value="Classique">Classique</option>
                <option value="Végétarien">Végétarien</option>
                <option value="Vegan">Vegan</option>
            </select>

            <label for="personnes">Nombre minimum de personnes</label>
            <input type="number" id="personnes" min="1">

            <label for="prix-min">Prix minimum</label>
            <input type="number" id="prix-min" min="0">

            <label for="prix-max">Prix maximum</label>
            <input type="number" id="prix-max" min="0">

            <p id="no-results" hidden>Aucun menu ne correspond à ces critères.</p>
        </div>

        <section class="menu-list">
            <h2>Menus disponibles</h2>

            {% for menu in menus %}
                <article
                    class="menu-card"
                    data-theme="{{ menu.theme }}"
                    data-regime="{{ menu.regime }}"
                    data-people="{{ menu.minPeople }}"
                    data-price="{{ menu.price }}"
                >
                    <h3>{{ menu.title }}</h3>

                    <p>{{ menu.description }}</p>

                    <p><strong>Thème :</strong> {{ menu.theme }}</p>
                    <p><strong>Régime :</strong> {{ menu.regime }}</p>
                    <p><strong>Minimum :</strong> {{ menu.minPeople }} personnes</p>
                    <p><strong>Prix :</strong> {{ menu.price }} €</p>

                    <a href="{{ path('app_menu_detail', {'id': menu.id}) }}">
                        Voir le détail
                    </a>
                </article>
            {% else %}
                <p>Aucun menu disponible actuellement.</p>
            {% endfor %}
        </section>
    </section>
</main>

<script>
    const themeFilter = document.getElementById('theme');
    const regimeFilter = document.getElementById('regime');
    const peopleFilter = document.getElementById('personnes');
    const minPriceFilter = document.getElementById('prix-min');
    const maxPriceFilter = document.getElementById('prix-max');
    const menuCards = document.querySelectorAll('.menu-card');
    const noResults = document.getElementById('no-results');

    function filterMenus() {
        const selectedTheme = themeFilter.value;
        const selectedRegime = regimeFilter.value;
        const selectedPeople = Number(peopleFilter.value);
        const selectedMinPrice = Number(minPriceFilter.value);
        const selectedMaxPrice = Number(maxPriceFilter.value);

        let visibleMenus = 0;

        menuCards.forEach((card) => {
            const menuTheme = card.dataset.theme;
            const menuRegime = card.dataset.regime;
            const menuPeople = Number(card.dataset.people);
            const menuPrice = Number(card.dataset.price);

            const matchesTheme =
                selectedTheme === '' || menuTheme === selectedTheme;

            const matchesRegime =
                selectedRegime === '' || menuRegime === selectedRegime;

            const matchesPeople =
                peopleFilter.value === '' || menuPeople <= selectedPeople;

            const matchesMinPrice =
                minPriceFilter.value === '' || menuPrice >= selectedMinPrice;

            const matchesMaxPrice =
                maxPriceFilter.value === '' || menuPrice <= selectedMaxPrice;

            const matches =
                matchesTheme &&
                matchesRegime &&
                matchesPeople &&
                matchesMinPrice &&
                matchesMaxPrice;

            card.hidden = !matches;

            if (matches) {
                visibleMenus++;
            }
        });

        noResults.hidden = visibleMenus !== 0;
    }

    themeFilter.addEventListener('change', filterMenus);
    regimeFilter.addEventListener('change', filterMenus);
    peopleFilter.addEventListener('input', filterMenus);
    minPriceFilter.addEventListener('input', filterMenus);
    maxPriceFilter.addEventListener('input', filterMenus);
</script>
{% endblock %}