{% extends 'base.html.twig' %}

{% block title %}Nos menus - Vite & Gourmand{% endblock %}

{% block body %}
<main>
    <section class="menus-section">
        <h1>Nos menus</h1>

        <p>Découvrez les menus proposés par Vite & Gourmand pour vos événements.</p>

        <div class="filters">
            <h2>Rechercher un menu</h2>

            <label for="theme">Thème</label>
            <select id="theme">
                <option value="">Tous</option>
                <option value="Classique">Classique</option>
                <option value="Noël">Noël</option>
                <option value="Pâques">Pâques</option>
                <option value="Événement">Événement</option>
            </select>

            <label for="regime">Régime</label>
            <select id="regime">
                <option value="">Tous</option>
                <option value="Classique">Classique</option>
                <option value="Végétarien">Végétarien</option>
                <option value="Vegan">Vegan</option>
            </select>

            <label for="personnes">Nombre minimum de personnes</label>
            <input type="number" id="personnes" min="1">

            <label for="prix-max">Prix maximum</label>
            <input type="number" id="prix-max" min="0">
        </div>

        <section class="menu-list">
            <h2>Menus disponibles</h2>

            {% for menu in menus %}
                <article class="menu-card">
                    <h3>{{ menu.title }}</h3>

                    <p>{{ menu.description }}</p>

                    <p><strong>Thème :</strong> {{ menu.theme }}</p>
                    <p><strong>Régime :</strong> {{ menu.regime }}</p>
                    <p><strong>Minimum :</strong> {{ menu.minPeople }} personnes</p>
                    <p><strong>Prix :</strong> {{ menu.price }} €</p>

                    <a href="{{ path('app_menu_detail', {'id': menu.id}) }}">
                        Voir le détail
                    </a>
                </article>
            {% else %}
                <p>Aucun menu disponible actuellement.</p>
            {% endfor %}
        </section>
    </section>
</main>
{% endblock %}