{% extends 'base.html.twig' %}

{% block title %}Espace employé - Commandes{% endblock %}

{% block body %}
<div class="container py-4">
    <h1>Espace employé — Commandes</h1>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}

    <section>
        <h2>Filtrer les commandes</h2>

        <form method="get" action="{{ path('app_employee_orders') }}">
            <div>
                <label for="client">Client</label>
                <input
                    type="search"
                    id="client"
                    name="client"
                    value="{{ clientFilter }}"
                    placeholder="Nom, prénom ou e-mail"
                >
            </div>

            <div>
                <label for="status">Statut</label>
                <select id="status" name="status">
                    <option value="">Tous les statuts</option>

                    {% for status in [
                        'en attente',
                        'acceptée',
                        'en préparation',
                        'en livraison',
                        'livrée',
                        'en attente de matériel',
                        'terminée'
                    ] %}
                        <option
                            value="{{ status }}"
                            {% if statusFilter == status %}selected{% endif %}
                        >
                            {{ status|capitalize }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <button type="submit">Filtrer</button>

            <a href="{{ path('app_employee_orders') }}">
                Réinitialiser
            </a>
        </form>
    </section>

    {% if orders is empty %}
        <p>Aucune commande ne correspond aux critères sélectionnés.</p>
    {% else %}
        <div style="overflow-x:auto;">
            <table>
                <thead>
                    <tr>
                        <th>N°</th>
                        <th>Client</th>
                        <th>Menu</th>
                        <th>Personnes</th>
                        <th>Livraison</th>
                        <th>Total</th>
                        <th>Statut</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                {% for order in orders %}
                    <tr>
                        <td>#{{ order.id }}</td>

                        <td>
                            {{ order.user.firstName }}
                            {{ order.user.lastName }}<br>
                            <small>{{ order.user.email }}</small>
                        </td>

                        <td>{{ order.menu.title }}</td>

                        <td>{{ order.people }}</td>

                        <td>
                            {{ order.deliveryDate|date('d/m/Y') }}
                            à {{ order.deliveryTime|date('H:i') }}<br>
                            <small>
                                {{ order.deliveryAddress }},
                                {{ order.deliveryPostalCode }}
                                {{ order.deliveryCity }}
                            </small>
                        </td>

                        <td>{{ order.totalPrice|number_format(2, ',', ' ') }} €</td>

                        <td>{{ order.status }}</td>

                        <td>
                            <form
                                method="post"
                                action="{{ path('app_employee_order_status', {id: order.id}) }}"
                            >
                                <input
                                    type="hidden"
                                    name="_token"
                                    value="{{ csrf_token('order-status-' ~ order.id) }}"
                                >

                                <label for="status-{{ order.id }}">
                                    Modifier le statut
                                </label>

                                <select
                                    id="status-{{ order.id }}"
                                    name="status"
                                >
                                    {% for status in [
                                        'en attente',
                                        'acceptée',
                                        'en préparation',
                                        'en livraison',
                                        'livrée',
                                        'en attente de matériel',
                                        'terminée'
                                    ] %}
                                        <option
                                            value="{{ status }}"
                                            {% if order.status == status %}selected{% endif %}
                                        >
                                            {{ status|capitalize }}
                                        </option>
                                    {% endfor %}
                                </select>

                                <button type="submit">
                                    Mettre à jour
                                </button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}